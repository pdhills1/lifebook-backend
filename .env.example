# Copy this file to .env and fill in real values. Never commit the real .env.

# Supabase project settings (find in Supabase dashboard > Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Resend (or chosen email provider) — for "book finished" notifications
RESEND_API_KEY=your-resend-api-key-here
NOTIFY_ADMIN_EMAIL=paul@example.com

# Storage bucket name (created in Supabase Storage)
PHOTOS_BUCKET=lifebook-photos
PDFS_BUCKET=lifebook-pdfs

# Server
PORT=3000
FRONTEND_URL=http://localhost:5173
